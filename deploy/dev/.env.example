# Copiar para .env e preencher com valores reais.
# O .env nunca vai para o repositório (RNF-10).
# Na password, usar só letras e números (símbolos como @ ou / quebram o DATABASE_URL).
POSTGRES_USER=core
POSTGRES_PASSWORD=mudar-isto
POSTGRES_DB=core

# RabbitMQ (interface de gestão em http://localhost:15672)
RABBITMQ_DEFAULT_USER=metro
RABBITMQ_DEFAULT_PASS=mudar-isto

# Keycloak: administrador (consola em http://localhost:8080)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=mudar-isto
